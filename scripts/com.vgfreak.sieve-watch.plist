<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vgfreak.sieve-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/alexwilson/.hermes/hermes-agent/venv/bin/python</string>
    <string>/Users/alexwilson/.hermes/plugins/sieve/scripts/watch.py</string>
  </array>
  <!-- Poll while the Mac is awake. -->
  <key>StartInterval</key>
  <integer>120</integer>
  <!-- Also run on a network change. A wake or reconnect usually touches these
       files, so a drop across a sleep is more likely to be seen instead of
       passing unnoticed until the next timer tick. Best effort: only a real
       sleep/wake cycle proves it fires. -->
  <key>WatchPaths</key>
  <array>
    <string>/Library/Preferences/SystemConfiguration/NetworkInterfaces.plist</string>
    <string>/Library/Preferences/SystemConfiguration/preferences.plist</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/alexwilson/.hermes/logs/sieve-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alexwilson/.hermes/logs/sieve-watch.err</string>
</dict>
</plist>
